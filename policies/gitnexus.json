{
  "id": "gitnexus",
  "description": "Trigger GitNexus auto-augmentation after Bash, Grep, Read, and Glob operations.",
  "version": "1",
  "runtime": "claude",
  "order": 40,
  "claude": {
    "hooks": [
      {
        "event": "PostToolUse",
        "matcher": "Bash|Grep|Read|Glob",
        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/gitnexus/gitnexus-hook.cjs",
        "timeout": 10000
      }
    ]
  }
}
